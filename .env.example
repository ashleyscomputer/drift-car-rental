# Drift currently runs without a persistent database.
# Optional Hostinger booking-confirmation email configuration:
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_ID=
HOSTINGER_MAIL_FROM_ADDRESS=ashley@kickstreet.store
HOSTINGER_MAIL_FROM_NAME=Drift Car Rental

# HOSTINGER_MAILBOX_ID must belong to ashley@kickstreet.store.
# Until that mailbox exists and is authorized in Hostinger, bookings still work but email sending stays disabled.
