# Copy to .env.local and configure server-side MySQL credentials.
# Alternatively run scripts/setup-local-mysql.ps1 for this Windows/MySQL 8.4 installation.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=drift_car_rental
MYSQL_USER=drift_local
MYSQL_PASSWORD=
# false only for this computer's local MySQL; use TLS for hosted databases.
MYSQL_SSL=false
# Hosted MySQL: set MYSQL_SSL=true and MYSQL_SSL_CA to the provider's PEM CA certificate.
# MYSQL_SSL_CA accepts actual newlines or literal \n sequences.
